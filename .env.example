# Bu fayl namuna — haqiqiy qiymatlarni .env ga yozing, .env ni hech qachon
# git'ga qo'shmang. Vercel'da esa Settings -> Environment Variables ga qo'yiladi.

# --- Telegram ---------------------------------------------------------------
# @BotFather -> /newbot yoki /token
BOT_TOKEN=

# Webhook'ni himoyalaydi: faqat Telegram yuborgan so'rov qabul qilinadi.
# Yasash: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Telegram ID'ingiz (@userinfobot ga yozing)
ADMIN_ID=

# Xona ocha oladigan boshqa o'qituvchilar, vergul bilan: 111111,222222
TEACHER_IDS=

# 1 bo'lsa hamma xona ocha oladi (tavsiya etilmaydi)
ALLOW_EVERYONE=

# --- Jitsi ------------------------------------------------------------------
# Bo'sh bo'lsa https://meet.jit.si ishlatiladi.
# O'z serveringiz bo'lsa: https://meet.example.com
JITSI_BASE_URL=

# --- Test boti (main.py, polling) -------------------------------------------
DATABASE_URL=
GROUP_ID=
